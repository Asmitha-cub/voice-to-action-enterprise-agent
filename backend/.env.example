# NEVER commit backend/.env. Copy this file to .env and fill in your own secrets.
# This .example file must contain PLACEHOLDERS ONLY — never real keys or passwords.
ENVIRONMENT=development
AUTH_ENABLED=true
APP_API_KEY=my-local-agent-key-123
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Groq is OpenAI-compatible and powers Whisper (STT) + the LLM planner. ---
# Without a key, the agent still runs using its deterministic planner fallback,
# but voice transcription (/commands/audio) will not work.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
WHISPER_MODEL=whisper-large-v3-turbo
MAX_AUDIO_MB=25
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=2

# --- PostgreSQL ---
# For Docker Compose this host is the service name "postgres".
DATABASE_URL=postgresql+psycopg://enterprise:enterprise@localhost:5432/enterprise_agent
SEED_ON_STARTUP=true

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge

# ======================================================================
# DELIVERY CHANNELS (pluggable notifications: email / whatsapp / teams / slack)
# ----------------------------------------------------------------------
# DEFAULT_CHANNELS is a comma list used when a request doesn't name channels.
DEFAULT_CHANNELS=email
HTTP_TIMEOUT_SECONDS=15

# --- Email channel (SMTP) -------------------------------------------------
# Docker Compose ships a Mailpit inbox so email works with NO real credentials:
#   SMTP_HOST=mailpit  SMTP_PORT=1025  (view mail at http://localhost:8025)
# For real Gmail delivery:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
#   SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-char Gmail App Password, no spaces>
#   SMTP_FROM=you@gmail.com
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=Enterprise Agent <no-reply@enterprise-agent.local>
# Optional fixed mailbox for every task notification. Leave empty to email the assignee.
TASK_NOTIFICATION_EMAIL=

# --- WhatsApp channel (Twilio) --------------------------------------------
# Sign up + enable the WhatsApp sandbox at https://www.twilio.com/whatsapp
# Recipient numbers come from each contact's phone field (E.164, e.g. +919876543210).
WHATSAPP_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Microsoft Teams channel (Incoming Webhook) ---------------------------
# In Teams: a channel -> ... -> Connectors -> Incoming Webhook -> copy the URL.
TEAMS_ENABLED=true
TEAMS_WEBHOOK_URL=

# --- Slack channel (Incoming Webhook) -------------------------------------
# Create one at https://api.slack.com/messaging/webhooks
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=
